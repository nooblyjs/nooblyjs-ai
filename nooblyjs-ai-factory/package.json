{
  "name": "nooblyjs-ai-factory",
  "version": "0.1.0",
  "description": "The Software Factory: engineering, build (issues in, verified PRs out, on the noobly harness) and test, one NooblyJS app at /factory",
  "type": "module",
  "bin": {
    "factory": "bin/factory.js"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/factory.js",
    "run": "npm start",
    "test": "node --test \"test/**/*.test.js\" \"quality/test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\" \"quality/test/**/*.test.js\"",
    "build": "node -e \"console.log('No build step: plain JavaScript')\"",
    "clean": "node -e \"for (const d of ['node_modules','coverage','dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "check:examples": "scripts/check-examples.sh"
  },
  "dependencies": {
    "nooblyjs-ai-harness": "file:../nooblyjs-ai-harness",
    "nooblyjs-ai-common": "file:../../nooblyjs-core/src/aiservice/common",
    "nooblyjs-core": "file:../../nooblyjs-core",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "express": "^5.2.1"
  }
}
