# =============================================================================
# noobly Wiki Platform — environment template
# Copy to `.env` at the repo root and fill in real values. NEVER commit the real .env.
# In production, inject these from a secret manager (e.g. Azure Key Vault).
# =============================================================================

# --- Core server ---------------------------------------------------------------
NODE_ENV=production
PORT=11001
# Base directory for file-based storage (data/, documents/, logs/, searchindex/)
APP_BASE_DIR=./.application
# Set to false only for trusted internal tools; true requires auth on all routes.
REQUIRE_LOGIN=true

# --- Sessions & security -------------------------------------------------------
# REQUIRED. Must be a strong random string of >= 32 chars in production
# (the app refuses to start in production otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated allow-list. Regex entries are supported, e.g.:
#   /^chrome-extension:\/\//,https://wiki.example.com
CORS_ORIGINS=

# Logging: set LOG_FORMAT=json in production for structured stdout logs.
LOG_FORMAT=json
LOG_LEVEL=info

# --- File I/O concurrency -----------------------------------------------------
# libuv's threadpool serves every async filesystem call and defaults to 4. This
# process runs several file-heavy jobs at once (search index build, chokidar's
# initial scan, the folder-tree walk's ~44,000 stat()s), and at four threads they
# queue behind each other — a 7s tree walk was observed taking minutes. app.js
# defaults this to 32 when unset; raise it further for a very large corpus.
UV_THREADPOOL_SIZE=32

# --- Folder tree --------------------------------------------------------------
# GET /applications/wiki/api/spaces/:id/folder-tree walks this many levels and
# flags anything deeper `truncated`; the nav fetches those on demand as the user
# drills in (?path=...). The old exhaustive walk is still available per request
# with depth=all, but it does not finish in reasonable time on a large content
# root — that is what this setting exists to avoid. Keep >= 2: the nav's root
# view paints two levels, and folder item counts need one level below that.
WIKI_TREE_DEPTH=2
# Hard recursion cap, applied even to depth=all. The walk follows symlinks (the
# content root is a directory of symlinked repositories), and nothing resolves
# real paths — so a link pointing at one of its own ancestors would otherwise
# recurse until the process dies.
WIKI_TREE_MAX_DEPTH=24

# --- Search index -------------------------------------------------------------
# The startup build loads the persisted index from disk and returns immediately
# when that works. When it can't, it reads and tokenises the WHOLE corpus, which
# starves everything else doing file I/O — so it is deferred rather than racing
# startup. Set to 0 to build immediately (old behaviour).
WIKI_INDEX_BOOT_DELAY_MS=20000
# Skip the startup build entirely; search then serves whatever is on disk and you
# rebuild on demand with POST /applications/wiki/api/search/rebuild.
WIKI_INDEX_ON_BOOT=true
# Set false to keep index builds read-only (documents needing a derived markdown
# sidecar stay searchable by file name only).
WIKI_DERIVE_ON_INDEX=true

# --- Authentication: Google OAuth2 (optional) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Authentication method: local | azure -------------------------------------
# Selects how users sign in. "local" = file-based username/password (default).
# "azure" = Microsoft Entra (Azure AD) SSO using the AZURE_AD_* values below.
# If set to azure but those values are missing, the app falls back to local.
AUTH_METHOD=local

# --- Authentication: Microsoft Entra (Azure AD) SSO (used when AUTH_METHOD=azure)
# Users are auto-redirected to Microsoft to sign in (no login form is shown).
# Requires HTTPS_ENABLED=true (the OIDC form_post callback needs a SameSite=None;
# Secure cookie). Register the redirect URI  <AZURE_AD_BASE_URL>/services/
# authservice/openid  as a "Web" platform on the Entra app. Admins can still sign
# in locally via the login page with ?local=1
#
# Profile photos: on sign-in the app pulls each user's Entra photo from Microsoft
# Graph into the avatar store (shown wherever uploaded pictures are). This uses an
# app-only (client-credentials) Graph call, so grant the app registration the
# Microsoft Graph "User.Read.All" APPLICATION permission and click "Grant admin
# consent". Without it, photos are skipped (logged) and sign-in is unaffected;
# a user's own uploaded picture is never overwritten by their Entra photo.
AZURE_AD_CLIENT_ID=
AZURE_AD_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_BASE_URL=https://localhost:11001

# --- HTTPS (optional; terminate TLS at a proxy in production instead) ----------
HTTPS_ENABLED=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_CA_PATH=
HTTPS_PASSPHRASE=
HTTP_REDIRECT_PORT=

# --- AI providers (consumed by digital-technologies-core / AI service) ---------
# Default local model via Ollama:
AI_MODEL=tinyllama:1.1b
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=tinyllama:1.1b

# Anthropic (optional):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Azure OpenAI (optional):
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_MAX_TOKENS=

# Google Gemini (optional):
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Feature flags -------------------------------------------------------------
# The Wiki AI assistant panel and document editing toggles are NOT env vars. They
# live in the core settings store under the "wiki" group — edit them in the
# datasources Settings screen (src/wiki/config/featureFlags.js).

# SECURITY (Production Readiness Audit C4): workflow transform/conditional steps
# run via node:vm, which is NOT a hardened sandbox. Leave DISABLED in production
# unless all workflow authors are fully trusted. Set to "enabled" to opt in.
WORKFLOW_CODE_EXECUTION=disabled

# Override the directory workflows are loaded from (optional; default: <repo root>/workflows).
WORKFLOWS_PATH=

# --- Integrations (optional) ---------------------------------------------------
# Bitbucket API token for code/workflow integrations. Store in a secret manager.
BITBUCKET_API_TOKEN=
# Bitbucket username used (with BITBUCKET_API_TOKEN) in repo clone URLs. The name
# must be BITBUCKET_USERNAME — this was previously listed as BITBUCKET_USER, which
# nothing reads, so a deployment that copied this template authenticated with an
# empty username and every clone failed on credentials that looked correctly set.
BITBUCKET_USERNAME=

# Pre-shared static service token for API clients OUTSIDE this process (scripts,
# curl, integrations). Pick any random secret (e.g. `openssl rand -hex 32`); the
# backend registers it at startup as a long-lived bearer token for a synthetic
# "workflow-service" user (src/wiki/initialize.js). NOTE: it goes in the
# repo-root .env (the file the app actually loads).
WORKFLOW_API_TOKEN=
#
# WORKFLOW_API_URL / WORKFLOW_API_USER / WORKFLOW_API_PASSWORD were removed on
# 2026-07-25. Workflow steps no longer call this backend over HTTP: schedule
# operations go through the file-based workflow bridge under
# APP_BASE_DIR/workflow/.bridge, and the context build reads spaces off disk.
# Nothing reads those three variables any more — delete them from your .env.
