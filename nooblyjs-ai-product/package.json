  "description": "The Product Factory engine: a NooblyJS hosted app (API only, at /product/api/v1) that owns the product artefacts and the drafting agents that produce them.",
  "homepage": "https://bitbucket.org/acme/nooblyjs-ai-product#readme",
  "bugs": {
    "url": "https://bitbucket.org/acme/nooblyjs-ai-product/issues"
  },
