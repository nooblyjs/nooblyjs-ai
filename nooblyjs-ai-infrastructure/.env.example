# Standalone mode only (npm start). When NooblyJS hosts this app, NooblyJS's own .env applies.
PORT=11008
# Where the standalone server keeps its files (this app's are in <DATA_DIR>/infrastructure).
DATA_DIR=./data
# mock is the only provisioner today (roadmap I9).
INFRA_PROVISIONER=mock
# How long the mock provisioner takes for each 10% of a run, in milliseconds.
INFRA_MOCK_STEP_MS=1200
# How often to check whether the drift sweep (every 6 business hours) is due, in milliseconds.
INFRA_SWEEP_CHECK_MS=60000
