# Copy to .env. All settings are optional.
PORT=11202
HOST=127.0.0.1
DATA_DIR=./data

# Without credentials, teammates run on an offline mock provider.
ANTHROPIC_API_KEY=
# Or a bearer token instead of an API key, and a gateway address:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# Force a provider: "mock" (offline) or "anthropic" (needs a key or token).
AI_PROVIDER=

# Signs the session cookie and CSRF tokens. Leave empty to generate one in data/system/session-secret.md.
SESSION_SECRET=
# true when served over HTTPS; TRUST_PROXY when behind a reverse proxy (e.g. 1).
COOKIE_SECURE=false
TRUST_PROXY=
# Password for admin@localhost, the first account (nooblyjs-core authservice), set on first start.
# Leave empty to have one generated into $DATA_DIR/core/auth/INITIAL_ADMIN_PASSWORD.txt.
DEFAULT_ADMIN_PASSWORD=

# Logging (nooblyjs-core): debug | info | warn | error. Log files go to $DATA_DIR/logs unless LOG_DIR is set.
LOG_LEVEL=info
# What the console shows: all (everything in the log file, nooblyjs-core included), app (only the app's own messages) or none.
LOG_CONSOLE=all
# LOG_DIR=
