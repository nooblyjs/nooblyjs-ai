# Copy to .env. All settings are optional.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Without credentials, teammates run on an offline mock provider.
ANTHROPIC_API_KEY=
# Or a bearer token instead of an API key, and a gateway address:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# Force a provider: "mock" (offline) or "anthropic" (needs a key or token).
AI_PROVIDER=

# Owner password set on first start (only when none is set yet). Leave empty to use the setup code printed in the log.
OWNER_PASSWORD=
# Signs session cookies. Leave empty to generate one in data/system/session-secret.md.
SESSION_SECRET=
# true when served over HTTPS; TRUST_PROXY when behind a reverse proxy (e.g. 1).
COOKIE_SECURE=false
TRUST_PROXY=
