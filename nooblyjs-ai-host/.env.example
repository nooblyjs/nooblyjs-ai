# NooblyJS settings (tech.md §9). Copy to .env for local development. Never commit .env.

# Where to listen. HOST stays 127.0.0.1 unless NooblyJS sits behind a proxy.
PORT=11001
HOST=127.0.0.1

# Data root: Markdown and YAML files. Gitignored.
DATA_DIR=./data

# production turns on secure cookies and refuses development-only settings.
NODE_ENV=development

# true shows the person picker on /login (seeded people, no password). Refused in production.
NOOBLY_DEV_LOGIN=true

# Emails (comma-separated) that become Owner when NooblyJS creates their record on their first sign-in.
# Everyone else starts as data/access/roles.yaml newPersonRole (Viewer). Never upgrades an existing record.
NOOBLY_OWNERS=

# Signs sessions. Generated per start when empty (everyone is signed out on restart).
SESSION_SECRET=

# true marks cookies Secure (always on in production). Set when serving over HTTPS.
COOKIE_SECURE=false

# Express "trust proxy" setting when behind a reverse proxy (e.g. 1 or loopback).
TRUST_PROXY=

# Base URL for deep links in notifications and Teams cards.
PUBLIC_BASE_URL=http://127.0.0.1:11001

# mock | anthropic (development only; refused when NODE_ENV=production). bedrock | vertex | azure are not built yet.
# With mock, agent teammates answer from data/chat/scripts.yaml and data/teams/scripts.yaml.
AI_PROVIDER=mock
# For AI_PROVIDER=anthropic: teammates answer with a real model (team chat, drafting, the Teams simulator).
# ANTHROPIC_API_KEY=

# nooblyjs-core file log level: error, warn, info or debug.
LOG_LEVEL=info

# Requests a signed-in person may make to /api/ in 15 minutes (Owners four times as many, signed-out callers a fifth).
API_RATE_LIMIT=500
# How long a scripted agent teammate "works" before its chat reply appears, in milliseconds (when no model is configured).
CHAT_MOCK_REPLY_MS=1500
# Sign-in attempts from one address in 15 minutes.
SIGN_IN_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# HTTPS (src/utils/createServer.js). With HTTPS_ENABLED=true the certificate files must exist
# (relative paths are resolved against the noobly repo), and an HTTP→HTTPS redirect also listens on
# HTTP_REDIRECT_PORT (default 80; use a port above 1024 without admin rights).
# ---------------------------------------------------------------------------
HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt
HTTPS_CA_PATH=
HTTPS_PASSPHRASE=
HTTP_REDIRECT_PORT=8080

# ---------------------------------------------------------------------------
# Sign-in: local (nooblyjs-core accounts, plus the dev picker) or azure (Microsoft Entra ID).
# azure needs the AZURE_AD_* values and HTTPS (Entra's form_post callback needs a Secure cookie).
# The Entra app's redirect URI is AZURE_AD_BASE_URL + /services/authservice/openid.
# ---------------------------------------------------------------------------
AUTH_METHOD=local
AZURE_AD_CLIENT_ID=
AZURE_AD_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_BASE_URL=

# ---------------------------------------------------------------------------
# nooblyjs-core providers. memory needs nothing else running.
# ---------------------------------------------------------------------------
CACHING_SERVICE=memory      # memory | redis
SEARCH_SERVICE=memory       # memory | solr (SOLR_URL, SOLR_COLLECTION)
QUEUE_SERVICE=memory        # memory | activemq (ACTIVEMQ_HOST, ACTIVEMQ_STOMP_PORT, ACTIVEMQ_USER, ACTIVEMQ_PASSWORD)

# ---------------------------------------------------------------------------------------------------------------
# Writing to Jira and Bitbucket (Phase 13). They are PRODUCTION systems. NooblyJS sends a write only when all three are
# true: DEVTOOLS_WRITES=true here, an Owner switched that system to Send in Platform · Settings · Integrations, and
# its write token below is set. Otherwise it records what it would send in the outbox and sends nothing.
# The read tokens (JIRA_API_TOKEN, BITBUCKET_API_TOKEN) are never used to write.
# DEVTOOLS_WRITES=true
# JIRA_WRITE_API_TOKEN=          # a token that may create issues, move them and comment, in the NooblyJS projects only
# BITBUCKET_WRITE_API_TOKEN=     # a token that may push branches and open pull requests, on the NooblyJS repositories only
# DEVTOOLS_SYNC_MINUTES=5        # how often NooblyJS reads the linked issues and open pull requests back

# Backups of data/ (Phase 13). With BACKUP_DIR set, NooblyJS makes one each night; npm run backup makes one now.
# BACKUP_DIR=../noobly-backups     # never inside DATA_DIR
# BACKUP_KEEP=14
# BACKUP_HOUR=2                  # local time

# Read each person's job title from Microsoft Graph at sign-in (onboarding suggests a work role from it). This adds
# the User.Read permission to the Entra sign-in. Leave it off until an admin has granted User.Read to the app
# registration: without that consent every sign-in stops at "Approval required".
# AZURE_AD_READ_PROFILE=true

# Start an empty data folder with the system files only: no sample people, teams, items or history. The same as
# running npm run seed:blank first. The default (unset) writes the PRD-031 sample story, for demos.
# NOOBLY_SAMPLE_DATA=false
