{
  "manifest_version": 3,
  "name": "NooblyJS",
  "short_name": "NooblyJS",
  "version": "0.1.0",
  "description": "NooblyJS beside the page you're on: ask a NooblyJS teammate about the Jira issue in front of you. You review everything before it goes anywhere.",
  "author": "Acme Retail",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open NooblyJS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://localhost/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/browse/*", "https://*.atlassian.net/jira/*"],
      "js": ["content/jira.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
