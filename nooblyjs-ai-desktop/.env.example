# Copy to .env and fill in the providers you want to use.
# At least one key is required to send messages. The app starts without any.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Server
PORT=3000
HOST=127.0.0.1

# Where everything is stored: projects, chats, settings, and the nooblyjs-core
# service data and logs (/services dashboards) under $DATA_DIR/noobly-core
DATA_DIR=./data

# Password for the /services admin (admin@localhost) created on first run.
# If unset, one is generated and written to $DATA_DIR/noobly-core/data/INITIAL_ADMIN_PASSWORD.txt
# DEFAULT_ADMIN_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info

# Optional: point a provider at a compatible gateway or proxy
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
