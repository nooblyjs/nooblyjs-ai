<%- include('partials/head', { title, nav: 'projects' }) %>
<div class="container app-page">

  <% if (!anyProviderConfigured) { %>
    <div class="alert alert-warning mb-4" role="alert">
      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
      <div>
        <strong>No LLM provider configured.</strong>
        Add an API key to your <code>.env</code> file and restart.
        <a href="/settings">See which variables to set <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  <% } %>

  <div class="page-head">
    <div>
      <h1>Projects</h1>
      <p class="lead text-muted mb-0">Each project carries a description that becomes standing context for every chat inside it.</p>
    </div>
    <button class="btn btn-primary" data-open-modal="new-project">
      <i class="bi bi-plus-lg" aria-hidden="true"></i> New project
    </button>
  </div>

  <% if (projects.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-folder-plus empty-icon" aria-hidden="true"></i>
      <h2>No projects yet</h2>
      <p class="text-muted">Create one to get started. The description you write becomes the context every chat inherits.</p>
      <button class="btn btn-primary" data-open-modal="new-project">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Create your first project
      </button>
    </div>
  <% } else { %>
    <ul class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 list-unstyled" id="project-grid">
      <% projects.forEach((p) => { %>
        <li class="col" data-project-id="<%= p.id %>">
          <div class="card h-100 project-card">
            <a class="project-card-link" href="/projects/<%= p.id %>">
              <h2 class="card-title">
                <i class="bi bi-folder2 text-accent" aria-hidden="true"></i> <%= p.name %>
              </h2>
              <% if (p.hasDescription) { %>
                <p class="card-text project-excerpt"><%= p.excerpt %></p>
              <% } else { %>
                <p class="card-text project-excerpt text-muted fst-italic">No description yet</p>
              <% } %>
            </a>
            <div class="card-footer d-flex align-items-center gap-3 small text-muted">
              <span><i class="bi bi-chat-left-text" aria-hidden="true"></i> <%= p.chatCount %> <%= p.chatCount === 1 ? 'chat' : 'chats' %></span>
              <span class="me-auto"><i class="bi bi-clock" aria-hidden="true"></i> <span data-relative-time="<%= p.updatedAt %>"><%= p.updatedAt.slice(0, 10) %></span></span>
              <button class="icon-btn icon-btn-danger" data-delete-project="<%= p.id %>" data-name="<%= p.name %>" aria-label="Delete <%= p.name %>" title="Delete project">
                <i class="bi bi-trash3" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="modal fade" id="new-project" tabindex="-1" aria-labelledby="new-project-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form class="modal-content" id="new-project-form">
      <div class="modal-header">
        <h2 class="modal-title" id="new-project-title">
          <i class="bi bi-folder-plus text-accent" aria-hidden="true"></i> New project
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="np-name">Name</label>
          <input class="form-control" id="np-name" name="name" type="text" required maxlength="100" autocomplete="off" placeholder="NMEA Parser">
        </div>
        <div>
          <label class="form-label" for="np-description">Description <span class="text-muted fw-normal">— used as context in every chat</span></label>
          <textarea class="form-control" id="np-description" name="description" rows="8" maxlength="20000"
            placeholder="A Rust CLI that parses NMEA 0183 sentences. Target stable Rust. Prefer terse answers with code first."></textarea>
        </div>
        <div class="alert alert-danger mt-3 mb-0" data-form-error role="alert" hidden></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-lg" aria-hidden="true"></i> Create project
        </button>
      </div>
    </form>
  </div>
</div>

<script type="module" src="/static/js/projects.js"></script>
<%- include('partials/foot') %>
