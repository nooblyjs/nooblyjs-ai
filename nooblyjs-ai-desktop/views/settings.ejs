<%- include('partials/head', { title, nav: 'settings' }) %>
<div class="container app-page app-narrow">
  <div class="page-head">
    <div>
      <h1>Settings</h1>
      <p class="lead text-muted mb-0">API keys are read from the environment only — they are never stored in your data folder.</p>
    </div>
  </div>

  <section class="card panel mb-4">
    <div class="panel-head"><h2><i class="bi bi-plug text-accent" aria-hidden="true"></i> Providers</h2></div>
    <ul class="list-group list-group-flush provider-list">
      <% providers.forEach((p) => { %>
        <li class="list-group-item d-flex align-items-start justify-content-between gap-3">
          <div>
            <span class="fw-semibold me-2"><%= p.label %></span>
            <code><%= p.apiKeyEnvVar %></code>
            <div class="d-flex flex-wrap gap-1 mt-2">
              <% p.models.forEach((m) => { %><span class="chip chip-static"><%= m.label %></span><% }) %>
            </div>
          </div>
          <% if (p.configured) { %>
            <span class="pill pill-task"><span class="status-dot status-dot-task"></span>Configured</span>
          <% } else { %>
            <span class="pill pill-off"><span class="status-dot status-dot-off"></span>Not configured</span>
          <% } %>
        </li>
      <% }) %>
    </ul>
    <p class="form-text mb-0">
      Set the variables above in <code>.env</code> at the project root, then restart the server.
      Models are listed in <code>src/config/models.js</code> and are yours to edit.
    </p>
  </section>

  <section class="card panel">
    <div class="panel-head">
      <h2><i class="bi bi-sliders text-accent" aria-hidden="true"></i> Global defaults</h2>
      <span class="small text-muted">Used when a project states no preference</span>
    </div>
    <form id="settings-form">
      <span class="form-label d-block">Default provider and model</span>
      <%- include('partials/modelPicker', {
        idPrefix: 'global',
        providers,
        selectedProvider: settings.defaultProvider,
        selectedModel: settings.defaultModel,
        allowInherit: true
      }) %>

      <div class="row g-3 mt-1">
        <div class="col-sm-6">
          <label class="form-label" for="temperature">Temperature</label>
          <input class="form-control" id="temperature" name="temperature" type="number" min="0" max="2" step="0.1" value="<%= settings.temperature %>">
        </div>
        <div class="col-sm-6">
          <label class="form-label" for="maxOutputTokens">Max output tokens</label>
          <input class="form-control" id="maxOutputTokens" name="maxOutputTokens" type="number" min="1" max="200000" step="256" value="<%= settings.maxOutputTokens %>">
        </div>
      </div>

      <div class="alert alert-danger mt-3 mb-0" data-form-error role="alert" hidden></div>
      <div class="d-flex align-items-center justify-content-end gap-3 mt-4">
        <span class="small text-muted" id="settings-status" aria-live="polite"></span>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-lg" aria-hidden="true"></i> Save settings
        </button>
      </div>
    </form>
  </section>
</div>

<script type="module" src="/static/js/settings.js"></script>
<%- include('partials/foot') %>
